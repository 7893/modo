{
  "name": "modo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "vars": {
    "API_BACKEND_URL": "https://tunnel.example.com",
    "SUPABASE_URL": "https://service.example.com"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}