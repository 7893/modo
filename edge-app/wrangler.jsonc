{
  "name": "modo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html",
        "**/*.css",
        "**/*.client.js"
      ],
      "fallthrough": true
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
