{
  "name": "modo-edge-app",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind.generated.css --minify",
    "dev": "pnpm build:css && wrangler dev",
    "deploy": "pnpm build:css && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "hono": "^4.13.20"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "12.17.0"
  }
}
