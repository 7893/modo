[Unit]
Description=MODO Unified Edge Data Bridge (API Gateway + Telemetry Ingestion)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=modo
WorkingDirectory=/opt/modo/data-bridge/src
EnvironmentFile=/etc/modo/modo.env
ExecStart=/opt/modo/data-bridge/venv/bin/python run_unified.py
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
