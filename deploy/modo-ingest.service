[Unit]
Description=MODO Telemetry Ingestion Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=modo
WorkingDirectory=/opt/modo/data-bridge/src
EnvironmentFile=/etc/modo/modo.env
ExecStart=/opt/modo/data-bridge/venv/bin/python ingest.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
