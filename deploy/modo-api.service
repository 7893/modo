[Unit]
Description=MODO Data Bridge API Gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=modo
WorkingDirectory=/opt/modo/data-bridge/src
EnvironmentFile=/etc/modo/modo.env
ExecStart=/opt/modo/data-bridge/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
