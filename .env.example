# MySQL HeatWave Database Configuration
MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_USER=modo_app
MYSQL_PASSWORD=replace-with-a-secret
MYSQL_DATABASE=modo_db
# Optional; defaults to ML_SCHEMA_<MYSQL_USER>
MYSQL_ML_SCHEMA=ML_SCHEMA_modo_app

# Ingest settings
SCRAPE_INTERVAL_SECONDS=60
CPU_WARMUP_SECONDS=1

# API settings
INTERNAL_API_SECRET=replace-with-a-long-random-value
SERVICE_NODE_NAME=modo-api
CORS_ORIGINS=http://localhost:8787
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_CLIENTS=10000
RATE_LIMIT_SWEEP_INTERVAL=60

# AutoML maintenance
# Opt in only after HeatWave AutoML has been configured and reviewed.
AUTO_RETRAIN_ENABLED=false
TRAINING_BACKUP_KEEP=2
